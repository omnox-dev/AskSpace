# AskSpace AI API Secrets & Configuration

# Groq API Key (Get a free key from console.groq.com)
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API Key (Get a free key from aistudio.google.com)
VITE_GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Default AI Provider: "groq", "gemini", or "builtin"
VITE_DEFAULT_AI_PROVIDER=groq

# Default Groq Model
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# Production Host Master Password / PIN (Bypasses individual room PINs)
VITE_HOST_ADMIN_PASSWORD=your_secure_host_password_here
